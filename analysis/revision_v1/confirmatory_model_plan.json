{
  "schema_version": "1.0",
  "plan_id": "rankcloak_revision_primary_v2_prespecified_confirmatory_models",
  "protocol_contract_revision": "payload_fidelity_v2",
  "result_schema_revision": "payload_aware_result_v2",
  "supersedes_plan_id": "rankcloak_revision_v1_prespecified_confirmatory_models",
  "frozen_before_confirmatory_results": true,
  "experimental_unit": "payload_trial",
  "segments_as_independent_observations_forbidden": true,
  "confidence_level": 0.95,
  "filters": {
    "primary_trials": {
      "evidence_status": "confirmatory_primary_v2_payload_fidelity_after_manifest_freeze",
      "study_phase": "primary_v2_confirmatory",
      "protocol_contract_revision": "payload_fidelity_v2",
      "result_schema_revision": "payload_aware_result_v2",
      "record_type": "rankcloak_trial",
      "replay_mode": "saved_token_ids"
    },
    "primary_features": {
      "evidence_status": "confirmatory_primary_v2_payload_fidelity_after_manifest_freeze",
      "study_phase": "primary_v2_confirmatory",
      "protocol_contract_revision": "payload_fidelity_v2",
      "result_schema_revision": "payload_aware_result_v2",
      "text_view": "full_message"
    },
    "runtime": {
      "runtime_scope": "trial"
    }
  },
  "reference_levels": {
    "model_id": "llama3_8b_instruct_q4_k_m",
    "protocol_variant": "nonseg_ascii_b16",
    "prompt_category": "casual_conversation",
    "payload_class": "sha256_hex"
  },
  "diagnostics": {
    "optimizer": "bobyqa",
    "maxfun": 200000,
    "nAGQ": 1,
    "singular_tolerance": 0.0001,
    "maximum_absolute_gradient": 0.002,
    "minimum_hessian_eigenvalue": 0.000001,
    "potential_separation_absolute_coefficient": 10.0,
    "poisson_overdispersion_threshold": 1.25,
    "poisson_underdispersion_threshold": 0.75
  },
  "models": [
    {
      "model_id": "primary_exact_recovery",
      "input": "trials",
      "engine": "lme4::glmer",
      "family": "binomial_logit",
      "outcome": "exact_recovery",
      "outcome_role": "compatibility_alias_for_exact_payload_recovery",
      "recovery_outcome_semantics": "original_serialized_payload_bytes_sha256_v1",
      "rank_replay_role": "diagnostic_only",
      "formula": "exact_recovery ~ model_id * protocol_variant + model_id * prompt_category + protocol_variant * prompt_category + payload_class + (1 | payload_name) + (1 | prompt_id)",
      "random_intercepts": ["payload_name", "prompt_id"],
      "all_success_or_zero_policy": "skip_unidentified_glmm_and_report_wilson_intervals",
      "required": true,
      "fixed_effects_fallback": false
    },
    {
      "model_id": "primary_artifact_counts",
      "input": "features",
      "engine": "lme4::glmer.nb",
      "family": "negative_binomial_log",
      "outcome_candidates": ["artifact_count", "surface_flag_total", "artifact_like_fragment_count"],
      "formula": "artifact_count ~ model_id * protocol_variant + model_id * prompt_category + protocol_variant * prompt_category + payload_class + offset(log(token_count)) + (1 | payload_name) + (1 | prompt_id)",
      "aggregation": "sum_segment_counts_once_per_trial_full_message",
      "poisson_dispersion_check": "prespecified_diagnostic_not_model_selection",
      "random_intercepts": ["payload_name", "prompt_id"],
      "required": true,
      "fixed_effects_fallback": false
    },
    {
      "model_id": "primary_effective_artifact_rate",
      "input": "trials",
      "engine": "lme4::lmer",
      "family": "gaussian",
      "outcome": "effective_artifact_bits_per_full_token",
      "formula": "effective_artifact_bits_per_full_token ~ model_id * protocol_variant + model_id * prompt_category + protocol_variant * prompt_category + payload_class + (1 | payload_name) + (1 | prompt_id)",
      "random_intercepts": ["payload_name", "prompt_id"],
      "required": true,
      "fixed_effects_fallback": false
    },
    {
      "model_id": "primary_cover_log_probability",
      "input": "features",
      "engine": "lme4::lmer",
      "family": "gaussian",
      "outcome": "mean_log_probability",
      "formula": "mean_log_probability ~ model_id * protocol_variant + model_id * prompt_category + protocol_variant * prompt_category + payload_class + (1 | payload_name) + (1 | prompt_id)",
      "aggregation": "token_weighted_mean_once_per_trial_full_message",
      "random_intercepts": ["payload_name", "prompt_id"],
      "required": true,
      "fixed_effects_fallback": false
    },
    {
      "model_id": "primary_heldout_evaluator_log_probability",
      "input": "features",
      "engine": "lme4::lmer",
      "family": "gaussian",
      "outcome": "heldout_evaluator_log_probability",
      "formula": "heldout_evaluator_log_probability ~ model_id * protocol_variant + model_id * prompt_category + protocol_variant * prompt_category + payload_class + (1 | payload_name) + (1 | prompt_id)",
      "aggregation": "token_weighted_mean_once_per_trial_full_message",
      "random_intercepts": ["payload_name", "prompt_id"],
      "required_when_column_available": true,
      "fixed_effects_fallback": false
    },
    {
      "model_id": "primary_payload_throughput",
      "input": "runtime",
      "engine": "lme4::lmer",
      "family": "gaussian_log_outcome",
      "outcome": "payload_bits_per_second",
      "formula": "log(payload_bits_per_second) ~ model_id * protocol_variant + model_id * prompt_category + protocol_variant * prompt_category + payload_class + (1 | payload_name) + (1 | prompt_id)",
      "join_metadata_from": "trials",
      "random_intercepts": ["payload_name", "prompt_id"],
      "required": true,
      "fixed_effects_fallback": false
    }
  ],
  "contrast_families": [
    {
      "family_id": "recovery_protocol_within_model",
      "model_id": "primary_exact_recovery",
      "factor": "protocol_variant",
      "by": ["model_id"],
      "scale": "response",
      "adjustment": "holm"
    },
    {
      "family_id": "recovery_model_within_protocol",
      "model_id": "primary_exact_recovery",
      "factor": "model_id",
      "by": ["protocol_variant"],
      "scale": "response",
      "adjustment": "holm"
    },
    {
      "family_id": "recovery_prompt_category",
      "model_id": "primary_exact_recovery",
      "factor": "prompt_category",
      "by": [],
      "scale": "response",
      "adjustment": "holm"
    },
    {
      "family_id": "artifact_protocol_within_model",
      "model_id": "primary_artifact_counts",
      "factor": "protocol_variant",
      "by": ["model_id"],
      "scale": "response",
      "adjustment": "holm"
    },
    {
      "family_id": "continuous_protocol_within_model",
      "model_id_pattern": "^primary_(effective|cover|heldout|payload)",
      "factor": "protocol_variant",
      "by": ["model_id"],
      "scale": "model",
      "adjustment": "holm_separately_by_outcome"
    }
  ],
  "human_model": {
    "model_id": "human_naturalness_and_suspiciousness_clmm",
    "engine": "ordinal::clmm",
    "status": "external_until_irb_approved_ratings_exist",
    "random_intercepts": ["participant_id", "stimulus_id", "prompt_id"],
    "recruitment_authorized": false
  },
  "detector_analysis": {
    "status": "handled_by_grouped_bootstrap_pipeline_not_mixed_model",
    "grouping_unit": "payload_group_id",
    "leakage_checks_required": true
  },
  "outputs": [
    "mixed_model_coefficients.csv",
    "mixed_model_contrasts.csv",
    "mixed_model_diagnostics.json",
    "recovery_wilson_sensitivity.csv",
    "poisson_dispersion_check.csv",
    "model_status.json",
    "mixed_model_run_manifest.json"
  ]
}
