  "reproduction_commands": [
    {
      "command": "python -m pytest -q",
      "label": "Validate source and deterministic fixtures"
    },
    {
      "command": "python scripts/build_revision_payload_manifest.py --help",
      "label": "Regenerate the public deterministic payload corpus"
    },
    {
      "command": "python scripts/run_revision_tokenizer_preflight.py --help",
      "label": "Verify the payload-fidelity-v2 tokenizer preflight"
    },
    {
      "command": "python scripts/run_revision_matrix.py --stage primary_v2 --dry-run",
      "label": "Inspect the frozen payload-fidelity-v2 primary matrix"
    },
    {
      "command": "python scripts/project_revision_compute.py --help",
      "label": "Recheck the compute projection gate"
    },
    {
      "command": "python scripts/build_revision_environment_lock.py --output-dir environment/revision_v1 --check --verify-model-files",
      "label": "Verify the offline environment snapshot"
    },
    {
      "command": "python scripts/run_revision_statistics.py --help",
      "label": "Run statistical analysis from supplied immutable inputs"
    },
    {
      "command": "python scripts/build_revision_reports.py --help",
      "label": "Regenerate manuscript figures and tables"
    },
    {
      "command": "python scripts/build_revision_confirmatory_release_index.py --dry-run",
      "label": "Verify the sealed confirmatory DAG and preview the exact release artifact index"
    },
    {
      "command": "python scripts/build_revision_confirmatory_release_index.py --check",
      "label": "Reverify the immutable confirmatory release index and every indexed byte"
    },
    {
      "command": "python tools/count_scientific_reports.py --help",
      "label": "Verify journal word and display-item limits"
    }
  ],
