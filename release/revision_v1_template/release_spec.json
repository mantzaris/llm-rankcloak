    {
      "command": "python scripts/build_revision_release.py --spec release/revision_v1_template/release_spec.json --output-dir /tmp/rankcloak-code-data-candidate --dry-run --require-final-ready",
      "label": "From a full source checkout: validate the archive recipe without writing output"
    },
    {
      "command": "python scripts/build_revision_release.py --spec release/revision_v1_template/release_spec.json --output-dir /tmp/rankcloak-code-data-candidate --require-final-ready",
      "label": "From a full source checkout: assemble a local candidate"
    },
    {
      "command": "python -B scripts/verify_revision_release.py . --require-doi-null",
      "label": "From the assembled candidate root: independently verify every staged byte"
    },
    {
      "command": "python tools/count_scientific_reports.py",
      "label": "From either tree: check the revised manuscript word and display-item counts"
    }
