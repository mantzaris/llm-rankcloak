\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces \textbf  {Full neural-detector evaluation.} The six panels report confirmatory frozen endpoints together with supplementary exploratory metrics. Matched error bars are payload-group bootstrap 95\% confidence intervals. Held-out regime bars span the minimum and maximum across prespecified splits and are not confidence intervals. Brier score is lower-is-better; high values in the other panels indicate stronger distinguishability and therefore weaker concealment.}}{13}{figure.caption.13}\protected@file@percent }
\newlabel{fig:detector-full}{{S5}{13}{\textbf {Full neural-detector evaluation.} The six panels report confirmatory frozen endpoints together with supplementary exploratory metrics. Matched error bars are payload-group bootstrap 95\% confidence intervals. Held-out regime bars span the minimum and maximum across prespecified splits and are not confidence intervals. Brier score is lower-is-better; high values in the other panels indicate stronger distinguishability and therefore weaker concealment}{figure.caption.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S12}{\ignorespaces Matched detector endpoints. Higher ROC-AUC, balanced accuracy, precision, and low-FPR sensitivity are adverse for concealment; lower Brier score indicates better detector calibration.}}{13}{table.caption.14}\protected@file@percent }
\newlabel{tab:detector-matched}{{S12}{13}{Matched detector endpoints. Higher ROC-AUC, balanced accuracy, precision, and low-FPR sensitivity are adverse for concealment; lower Brier score indicates better detector calibration}{table.caption.14}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S13}{\ignorespaces Ranges across heterogeneous frozen held-out splits. These ranges are not pooled confidence intervals.}}{14}{table.caption.15}\protected@file@percent }
\newlabel{tab:detector-ranges}{{S13}{14}{Ranges across heterogeneous frozen held-out splits. These ranges are not pooled confidence intervals}{table.caption.15}{}}
\newlabel{si:s8}{{}{14}{}{table.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces \textbf  {Theoretical capacity-tail validation.} Fixed-radix payload length and effective full-message rate are checked against their declared algebraic bounds, while the cover-length residual isolates tokens beyond the forced payload positions. Across 17,424 retained records, 7,008 were evaluable for the complete plotted capacity and supported quality-bound checks; no forced-position, rate-bound, or evaluated quality-bound violation occurred. Positive residuals in 2,976 records represent natural tails or other cover overhead. This validation tests retained-field identities and differs from the empirical common-support frontier in Main Fig. 2; neither analysis is evidence of human-perceived naturalness.}}{16}{figure.caption.16}\protected@file@percent }
\newlabel{fig:capacity-validation}{{S6}{16}{\textbf {Theoretical capacity-tail validation.} Fixed-radix payload length and effective full-message rate are checked against their declared algebraic bounds, while the cover-length residual isolates tokens beyond the forced payload positions. Across 17,424 retained records, 7,008 were evaluable for the complete plotted capacity and supported quality-bound checks; no forced-position, rate-bound, or evaluated quality-bound violation occurred. Positive residuals in 2,976 records represent natural tails or other cover overhead. This validation tests retained-field identities and differs from the empirical common-support frontier in Main Fig. 2; neither analysis is evidence of human-perceived naturalness}{figure.caption.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S14}{\ignorespaces Empirical capacity and traceability audit.}}{16}{table.caption.17}\protected@file@percent }
\newlabel{tab:theory-validation}{{S14}{16}{Empirical capacity and traceability audit}{table.caption.17}{}}
\newlabel{si:s9}{{}{16}{}{table.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S7}{\ignorespaces \textbf  {Complete computational-overhead summary.} Primary model protocol cells show payload-bootstrap summaries for inclusive generation, encoding setup, supported recovery, throughput, and effective rate. The setup panel uses a logarithmic axis because cells span several orders of magnitude. CPU time and repeated warm-up measurements were unavailable and wall time is not relabeled as CPU time.}}{17}{figure.caption.18}\protected@file@percent }
\newlabel{fig:overhead-full}{{S7}{17}{\textbf {Complete computational-overhead summary.} Primary model protocol cells show payload-bootstrap summaries for inclusive generation, encoding setup, supported recovery, throughput, and effective rate. The setup panel uses a logarithmic axis because cells span several orders of magnitude. CPU time and repeated warm-up measurements were unavailable and wall time is not relabeled as CPU time}{figure.caption.18}{}}
